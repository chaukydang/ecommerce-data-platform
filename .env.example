# ---- copy to .env (never commit real values) ----------------------------------------
# GCP / existing Olist pipeline
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_SERVICE_ACCOUNT_KEY=
BQ_LOCATION=us-east1

# Omnichannel platform
PLATFORM_DB_URL=postgresql+psycopg2://platform:platform@localhost:5433/platform   # sqlite:///platform.db for quick local runs
PLATFORM_SINK=duckdb                       # duckdb (local) | bigquery
DUCKDB_PATH=warehouse.duckdb

# SIMULATED source APIs (replace the URLs/tokens when integrating real systems)
SIM_API_TOKEN=sim-token
MARKETPLACE_API_URL=http://localhost:8000
MARKETPLACE_API_TOKEN=sim-token
OMS_API_URL=http://localhost:8000
OMS_API_TOKEN=sim-token
POS_API_URL=http://localhost:8000
POS_API_TOKEN=sim-token
FINANCE_API_URL=http://localhost:8000
FINANCE_API_TOKEN=sim-token

# Alerting - Lark custom bot webhook (leave empty = alerts are printed to the log)
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
ALERT_COOLDOWN_MINUTES=60

# Real source: Shopify development store (docs/shopify_quickstart.md)
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=          # alternative: static Admin API token
# SHOPIFY_API_VERSION=2026-01
